# Discord bot token (Developer Portal > Your App > Bot > Reset Token)
DISCORD_TOKEN=

# Application (client) ID, used when registering slash commands
DISCORD_CLIENT_ID=

# Optional: restrict where the bot posts calendar links.
# If unset, the bot posts in the guild's system channel (falling back to the
# first text channel it can send to).
DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Local HTTP message endpoint (used by the digest job) ---
# Shared secret required to POST /dm. If unset, the endpoint is disabled.
BISHOP_HTTP_TOKEN=
# Where the endpoint listens. Keep on loopback unless something off-box needs it.
BISHOP_HTTP_HOST=127.0.0.1
BISHOP_HTTP_PORT=8787
# Numeric Discord user ID to DM by default (Developer Mode > right-click you >
# Copy User ID). The bot must share a server with this user to DM them.
DISCORD_DM_USER_ID=

# --- Daily gut check-in (DMs only, no typed commands) ---
# Comma-separated Discord user ids to send the 21:00 check-in to. Nobody else is
# messaged or answered. Can also live in data/survey/config.json as
# {"user_ids": ["..."]}; the two are merged.
SURVEY_USER_IDS=
# Optional: where that config file is. Default data/survey/config.json
SURVEY_CONFIG_PATH=
# Local time of the check-in. Default 21:00
SURVEY_AT=21:00
# IANA zone the time above is read in. Default America/New_York
SURVEY_TIME_ZONE=America/New_York
# Where the JSONL entries, state.json and drafts.json live. Default data/survey
BISHOP_SURVEY_DIR=
# Send one check-in immediately at startup, for a deploy smoke test.
SURVEY_SEND_ON_START=0
